   "source": [
    "## 11. Interpretation at Original Variable Level\n",
    "\n",
    "One-hot encoding creates several transformed features from the same original\n",
    "categorical variable.\n",
    "\n",
    "For interpretation, transformed feature names are mapped back to their\n",
    "original employee characteristics whenever possible."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "868e48cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_PATH = \""../../data/raw/WA_Fn-UseC_-HR-Employee-Attrition.csv\"\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "\n",
    "columns_to_remove = [\n",
    "    \"EmployeeNumber\",\n",
    "    \"EmployeeCount\",\n",
    "    \"Over18\",\n",
    "    \"StandardHours\"\n",
    "]\n",
    "\n",
    "df_model = df.drop(columns=columns_to_remove)\n",
    "\n",
    "original_variables = list(\n",
    "    df_model.drop(columns=[\"Attrition\"]).columns\n",
    ")\n",
    "\n",
    "categorical_features = (\n",
    "    df_model\n",
    "    .drop(columns=[\"Attrition\"])\n",
    "    .select_dtypes(exclude=np.number)\n",
    "    .columns\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "def map_to_original_variable(feature_name):\n",
    "    \"\"\"\n",
    "    Map a transformed feature name back to the corresponding\n",
    "    original predictor.\n",
    "    \"\"\"\n",
    "\n",
    "    clean_name = feature_name.split(\"__\", 1)[-1]\n",
    "\n",
    "    # Numerical features retain their original names.\n",
    "    if clean_name in original_variables:\n",
    "        return clean_name\n",
    "\n",
    "    # One-hot encoded features start with the original\n",
    "    # categorical variable name followed by an underscore.\n",
    "    categorical_matches = [\n",
    "        col for col in categorical_features\n",
    "        if clean_name.startswith(col + \"_\")\n",
    "    ]\n",
    "\n",
    "    if categorical_matches:\n",
    "        return max(\n",
    "            categorical_matches,\n",
    "            key=len\n",
    "        )\n",
    "\n",
    "    return clean_name"
   ]
  },
